    <queries>
        <package android:name="com.uclone.slices.v2" />
        <package android:name="com.miui.home" />
        <package android:name="com.uclone.slices.fixture" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_hook"
        android:label="@string/app_name"
